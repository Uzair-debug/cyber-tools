    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/zxcvbn": "^4.4.5",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.475.0",
    "next": "^16.4.3",
    "postal-mime": "^2.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "wrangler": "^4.155.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
